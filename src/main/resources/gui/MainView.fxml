<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>

<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ducknetwork.gui.DuckController">
    <children>
        <TabPane tabClosingPolicy="UNAVAILABLE" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <tabs>
                <Tab text="Vizualizare Rate">
                    <content>
                        <VBox alignment="TOP_CENTER" spacing="10.0">
                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                            <children>
                                <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Catalog Rate" />
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label text="Filtreaza dupa tip:" />
                                    <ComboBox fx:id="comboBoxDuckFilterType" prefWidth="200.0" promptText="Alege tipul..." />
                                </HBox>
                                <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="tableColumnId" prefWidth="50.0" text="ID" />
                                        <TableColumn fx:id="tableColumnUsername" prefWidth="120.0" text="Username" />
                                        <TableColumn fx:id="tableColumnEmail" prefWidth="150.0" text="Email" />
                                        <TableColumn fx:id="tableColumnType" prefWidth="120.0" text="Tip" />
                                        <TableColumn fx:id="tableColumnSpeed" prefWidth="80.0" text="Viteza" />
                                        <TableColumn fx:id="tableColumnEndurance" prefWidth="80.0" text="Rezistenta" />
                                    </columns>
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                </TableView>
                                <HBox alignment="CENTER" spacing="15.0">
                                    <Button fx:id="prevButton" onAction="#handlePrevPage" text="&lt; Pagina Anterioară" />
                                    <Label fx:id="pageInfoLabel" text="Pagina X din Y" />
                                    <Button fx:id="nextButton" onAction="#handleNextPage" text="Pagina Următoare &gt;" />
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="Administrare ">
                    <content>
                        <HBox spacing="20.0">
                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                            <children>
                                <VBox spacing="10.0" HBox.hgrow="ALWAYS" style="-fx-border-color: #ccc; -fx-padding: 10;">
                                    <Label style="-fx-font-weight: bold;" text="Adaugare Utilizator Nou" />
                                    <TextField fx:id="txtUsername" promptText="Username" />
                                    <TextField fx:id="txtEmail" promptText="Email" />
                                    <PasswordField fx:id="txtPassword" promptText="Parola" />
                                    <ComboBox fx:id="comboUserType" prefWidth="150.0" promptText="Selecteaza Tip" />
                                    <VBox fx:id="personFieldsContainer" spacing="5.0" visible="false" managed="false">
                                        <TextField fx:id="txtFirstName" promptText="Prenume" />
                                        <TextField fx:id="txtLastName" promptText="Nume Familie" />
                                        <TextField fx:id="txtBirthDate" promptText="Data Nasterii (YYYY-MM-DD)" />
                                        <TextField fx:id="txtOccupation" promptText="Ocupatie" />
                                        <TextField fx:id="txtEmpathy" promptText="Empatie (int)" />
                                    </VBox>
                                    <VBox fx:id="duckFieldsContainer" spacing="5.0" visible="false" managed="false">
                                        <TextField fx:id="txtSpeed" promptText="Viteza (ex: 10.5)" />
                                        <TextField fx:id="txtEndurance" promptText="Rezistenta (ex: 5.0)" />
                                        <ComboBox fx:id="comboDuckCreationType" prefWidth="150.0" promptText="Tip Rață" />
                                    </VBox>
                                    <Button text="Adauga Utilizator" onAction="#handleAddUser" maxWidth="Infinity" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                                    <Separator />
                                    <Label style="-fx-font-weight: bold;" text="Stergere Utilizator (Email)" />
                                    <TextField fx:id="txtDeleteEmail" promptText="Email Utilizator de sters" />
                                    <Button text="Sterge Utilizator" onAction="#handleDeleteUser" maxWidth="Infinity" style="-fx-background-color: #F44336; -fx-text-fill: white;"/>
                                </VBox>

                                <VBox spacing="10.0" HBox.hgrow="ALWAYS" style="-fx-border-color: #ccc; -fx-padding: 10;">
                                    <Label style="-fx-font-weight: bold;" text="Gestiune Prietenii" />
                                    <ComboBox fx:id="comboUser1Email" maxWidth="Infinity" promptText="Alege User 1 (Email)" />
                                    <ComboBox fx:id="comboUser2Email" maxWidth="Infinity" promptText="Alege User 2 (Email)" />
                                    <HBox spacing="10.0" alignment="CENTER">
                                        <Button text="Adauga" onAction="#handleAddFriend" style="-fx-background-color: #2196F3; -fx-text-fill: white;" />
                                        <Button text="Sterge" onAction="#handleRemoveFriend" style="-fx-background-color: #FF9800; -fx-text-fill: white;" />
                                    </HBox>
                                    <Separator />
                                    <Label style="-fx-font-weight: bold;" text="Prietenii Existente" />
                                    <TableView fx:id="friendshipTable" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colUser1Email" prefWidth="150.0" text="User 1" />
                                            <TableColumn fx:id="colUser2Email" prefWidth="150.0" text="User 2" />
                                        </columns>
                                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                    </TableView>
                                    <Button fx:id="btnOpenChat" text="Deschide Chat" onAction="#handleOpenChat" disable="true" maxWidth="Infinity" style="-fx-background-color: #9C27B0; -fx-text-fill: white;"/>

                                    <Label fx:id="lblStatus" text=" " textFill="grey" wrapText="true"/>
                                </VBox>
                            </children>
                        </HBox>
                    </content>
                </Tab>

                <Tab text="Statistici Comunitati">
                    <content>
                        <VBox alignment="CENTER" spacing="20.0">
                            <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
                            <children>
                                <Button text="Calculeaza Statistici" onAction="#handleCalculateStats" style="-fx-font-size: 14px; -fx-padding: 10 20;"/>
                                <GridPane hgap="20.0" vgap="10.0" alignment="CENTER">
                                    <children>
                                        <Label text="Numar Comunitati:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                        <Label fx:id="lblCommunityCount" text="-" style="-fx-font-size: 18px;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                        <Label text="Cea mai sociabila comunitate:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.valignment="TOP"/>
                                        <TextArea fx:id="txtMostSociable" editable="false" prefHeight="150.0" prefWidth="300.0" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                    </children>
                                </GridPane>
                            </children>
                        </VBox>
                    </content>
                </Tab>
                <Tab text="Friend Requests">
                    <content>
                        <VBox spacing="10.0" style="-fx-padding: 20;">
                            <Label fx:id="lblNotificari" text="Notificari" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                            <ListView fx:id="listNotifications" VBox.vgrow="ALWAYS" />
                            <HBox spacing="10" alignment="CENTER">
                                <Button text="Accepta" onAction="#handleAcceptRequest" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                                <Button text="Respinge" onAction="#handleRejectRequest" style="-fx-background-color: #F44336; -fx-text-fill: white;"/>
                                <Button text="Refresh" onAction="#refreshNotifications" />
                            </HBox>
                        </VBox>
                    </content>
                </Tab>
                <Tab text="Chats">
                    <VBox spacing="10" style="-fx-padding: 20;">
                        <Label text="Incepe o conversație noua:" style="-fx-font-weight: bold;" />
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="txtSearchChatEmail" promptText="Search email" HBox.hgrow="ALWAYS" />
                            <Button text="🔎" onAction="#handleSearchAndChat" style="-fx-background-color: #2196F3; -fx-text-fill: white;" />

                            <Button fx:id="btnQuickFriendRequest" text="Trimite Cerere" onAction="#handleQuickRequest"
                                    visible="false" managed="false" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
                            <Label fx:id="lblFriendStatus" text="✓ Prieteni"
                                   visible="false" managed="false" style="-fx-text-fill: #4CAF50; -fx-font-weight: bold;" />
                        </HBox>

                        <Separator />

                        <Label text="Chat-uri recente:" />
                        <ListView fx:id="listRecentChats" VBox.vgrow="ALWAYS" />

                        <Label fx:id="lblChatStatus" text="" wrapText="true" style="-fx-text-fill: #555; -fx-font-style: italic;" />

                        <Button text="Deschide Chat" onAction="#handleOpenRecentChat" maxWidth="Infinity" />
                    </VBox>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</AnchorPane>