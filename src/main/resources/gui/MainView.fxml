<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ducknetwork.gui.DuckController">
    <children>
        <TabPane layoutX="15.0" layoutY="15.0" prefHeight="570.0" prefWidth="870.0" tabClosingPolicy="UNAVAILABLE" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
            <tabs>
                <Tab text="Ducks Network">
                    <content>
                        <VBox spacing="10.0" style="-fx-padding: 15;">
                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <Label text="Filter by Type:" />
                                <ComboBox fx:id="comboBoxDuckFilterType" prefWidth="150.0" />
                            </HBox>
                            <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="tableColumnId" text="ID" prefWidth="50" />
                                    <TableColumn fx:id="tableColumnUsername" text="Username" prefWidth="150" />
                                    <TableColumn fx:id="tableColumnEmail" text="Email" prefWidth="200" />
                                    <TableColumn fx:id="tableColumnType" text="Type" prefWidth="100" />
                                    <TableColumn fx:id="tableColumnSpeed" text="Speed" prefWidth="100" />
                                    <TableColumn fx:id="tableColumnEndurance" text="Endurance" prefWidth="100" />
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                            </TableView>
                            <HBox alignment="CENTER" spacing="20.0">
                                <Button fx:id="prevButton" onAction="#handlePrevPage" text="Previous" />
                                <Label fx:id="pageInfoLabel" text="Page 1" />
                                <Button fx:id="nextButton" onAction="#handleNextPage" text="Next" />
                            </HBox>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="Friend Requests">
                    <content>
                        <VBox spacing="10.0" style="-fx-padding: 20;">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label fx:id="lblNotificari" text="Notificari" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                                <Circle fx:id="dotNewNotifications" radius="5.0" fill="RED" visible="false" />
                            </HBox>
                            <ListView fx:id="listNotifications" VBox.vgrow="ALWAYS" />
                            <HBox spacing="10" alignment="CENTER">
                                <Button text="Accepta" onAction="#handleAcceptRequest" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                                <Button text="Respinge" onAction="#handleRejectRequest" style="-fx-background-color: #F44336; -fx-text-fill: white;"/>
                                <Button text="Refresh" onAction="#refreshNotifications" />
                            </HBox>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="Chats">
                    <content>
                        <GridPane hgap="10" vgap="10" style="-fx-padding: 20;">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="40" />
                                <ColumnConstraints percentWidth="60" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints vgrow="ALWAYS" />
                            </rowConstraints>

                            <VBox spacing="10" GridPane.columnIndex="0">
                                <Label text="Recent Chats" style="-fx-font-weight: bold;" />
                                <ListView fx:id="listRecentChats" VBox.vgrow="ALWAYS" />
                                <Button text="Open Selected Chat" onAction="#handleOpenRecentChat" maxWidth="Infinity" />
                            </VBox>

                            <VBox spacing="15" GridPane.columnIndex="1">
                                <Label text="Search User to Chat" style="-fx-font-weight: bold;" />
                                <HBox spacing="10">
                                    <TextField fx:id="txtSearchChatEmail" promptText="Enter user email..." HBox.hgrow="ALWAYS" />
                                    <Button text="Search &amp; Chat" onAction="#handleSearchAndChat" />
                                </HBox>
                                <Label fx:id="lblChatStatus" text="" />
                                <Label fx:id="lblFriendStatus" text="Sunteti deja prieteni!" visible="false" style="-fx-text-fill: green;" />
                                <Button fx:id="btnQuickFriendRequest" text="Send Friend Request" visible="false" onAction="#handleQuickRequest" style="-fx-background-color: #2196F3; -fx-text-fill: white;" />
                            </VBox>
                        </GridPane>
                    </content>
                </Tab>

                <Tab text="Administrare">
                    <content>
                        <ScrollPane fitToWidth="true">
                            <VBox spacing="20.0" style="-fx-padding: 20;">
                                <VBox spacing="10.0" style="-fx-border-color: lightgray; -fx-border-width: 1; -fx-padding: 10;">
                                    <Label text="Adaugă Utilizator" style="-fx-font-weight: bold;" />
                                    <GridPane hgap="10.0" vgap="5.0">
                                        <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                        <TextField fx:id="txtUsername" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                        <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                        <TextField fx:id="txtEmail" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                        <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                        <PasswordField fx:id="txtPassword" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                        <Label text="Tip Utilizator:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                        <ComboBox fx:id="comboUserType" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                    </GridPane>
                                    <StackPane>
                                        <VBox fx:id="personFieldsContainer" spacing="5.0" visible="false">
                                            <GridPane hgap="10.0" vgap="5.0">
                                                <Label text="First Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                                <TextField fx:id="txtFirstName" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                                <Label text="Last Name:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                                <TextField fx:id="txtLastName" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                <Label text="Birth Date:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                                <TextField fx:id="txtBirthDate" promptText="YYYY-MM-DD" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                                <Label text="Occupation:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                                <TextField fx:id="txtOccupation" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                                <Label text="Empathy:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                                <TextField fx:id="txtEmpathy" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                            </GridPane>
                                        </VBox>
                                        <VBox fx:id="duckFieldsContainer" spacing="5.0" visible="false">
                                            <GridPane hgap="10.0" vgap="5.0">
                                                <Label text="Duck Type:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                                <ComboBox fx:id="comboDuckCreationType" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                                <Label text="Speed:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                                <TextField fx:id="txtSpeed" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                <Label text="Endurance:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                                <TextField fx:id="txtEndurance" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                            </GridPane>
                                        </VBox>
                                    </StackPane>
                                    <Button onAction="#handleAddUser" text="Salvează Utilizator" />
                                </VBox>
                                <VBox spacing="10.0" style="-fx-border-color: lightgray; -fx-border-width: 1; -fx-padding: 10;">
                                    <Label text="Șterge Utilizator" style="-fx-font-weight: bold;" />
                                    <HBox spacing="10.0">
                                        <TextField fx:id="txtDeleteEmail" promptText="Email de șters" />
                                        <Button onAction="#handleDeleteUser" text="Șterge" style="-fx-background-color: #ff4444; -fx-text-fill: white;" />
                                    </HBox>
                                </VBox>
                                <VBox spacing="10.0" style="-fx-border-color: lightgray; -fx-border-width: 1; -fx-padding: 10;">
                                    <Label text="Gestiune Prietenii" style="-fx-font-weight: bold;" />
                                    <TableView fx:id="friendshipTable" prefHeight="200.0">
                                        <columns>
                                            <TableColumn fx:id="colUser1Email" text="User 1 Email" />
                                            <TableColumn fx:id="colUser2Email" text="User 2 Email" />
                                        </columns>
                                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                                    </TableView>
                                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                                        <ComboBox fx:id="comboUser1Email" promptText="User 1" />
                                        <ComboBox fx:id="comboUser2Email" promptText="User 2" />
                                        <Button onAction="#handleAddFriend" text="Adaugă Prieten" />
                                        <Button onAction="#handleRemoveFriend" text="Șterge" />
                                        <Button onAction="#handleOpenChat" text="Chat" />
                                    </HBox>
                                </VBox>
                                <Label fx:id="lblStatus" text="" />
                            </VBox>
                        </ScrollPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</AnchorPane>