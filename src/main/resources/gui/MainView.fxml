<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ducknetwork.gui.DuckController">
    <children>
        <VBox alignment="TOP_CENTER" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>

                <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Gestiune Rate (Duck Manager)" />

                <AnchorPane prefHeight="50.0">
                    <children>
                        <Label layoutX="14.0" layoutY="17.0" text="Filtreaza dupa tip:" />
                        <ComboBox fx:id="comboBoxType" layoutX="130.0" layoutY="13.0" prefWidth="200.0" promptText="Alege tipul..." />
                    </children>
                </AnchorPane>

                <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
                    <columns>

                        <TableColumn fx:id="tableColumnId" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="tableColumnUsername" prefWidth="120.0" text="Username" />
                        <TableColumn fx:id="tableColumnEmail" prefWidth="150.0" text="Email" />
                        <TableColumn fx:id="tableColumnType" prefWidth="120.0" text="Tip" />

                        <TableColumn fx:id="tableColumnSpeed" prefWidth="80.0" text="Viteza" />
                        <TableColumn fx:id="tableColumnEndurance" prefWidth="80.0" text="Rezistenta" />
                    </columns>
                    <columnResizePolicy>

                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER" spacing="15.0">
                    <Button fx:id="prevButton" text="&lt; Pagina Anterioară" onAction="#handlePrevPage"/>
                    <Label fx:id="pageInfoLabel" text="Pagina X din Y" />
                    <Button fx:id="nextButton" text="Pagina Următoare &gt;" onAction="#handleNextPage"/>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>